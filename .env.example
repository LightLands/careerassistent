# Обязательно: получи токен у @BotFather
BOT_TOKEN=ваш_токен_бота

# Опционально: для OpenRouter AI (бесплатно на https://openrouter.ai/)
OPENROUTER_API_KEY=ваш_ключ_если_нужен
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Опционально: прокси
PROXY_URL=

# Опционально: уровень логирования
LOG_LEVEL=INFO
